# =============================================================================
# PlayLexi Environment Variables
# Copy this file to .env.local and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# Wispr Flow (for voice recognition)
# Get your API key from https://wisprflow.ai
# Used by speech-server to stream audio for real-time transcription
# -----------------------------------------------------------------------------
WISPR_API_KEY=your-wispr-api-key

# -----------------------------------------------------------------------------
# Merriam-Webster Dictionary API
# Get these from https://dictionaryapi.com/
# -----------------------------------------------------------------------------
MERRIAM_WEBSTER_LEARNERS_KEY=your-learners-api-key
MERRIAM_WEBSTER_COLLEGIATE_KEY=your-collegiate-api-key

# -----------------------------------------------------------------------------
# Google OAuth (for user authentication)
# Get these from Google Cloud Console -> APIs & Services -> Credentials
# Create an OAuth 2.0 Client ID (Web application type)
# Add authorized redirect URI: http://localhost:3000/api/auth/callback/google
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret

# -----------------------------------------------------------------------------
# Better Auth Configuration
# -----------------------------------------------------------------------------
# Generate a random 32+ character string for session security
# You can use: openssl rand -base64 32
BETTER_AUTH_SECRET=your-random-secret-at-least-32-characters

# Base URL for your app (used for OAuth callbacks)
BETTER_AUTH_URL=http://localhost:3000

# Public URL for client-side auth (must be prefixed with NEXT_PUBLIC_)
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# OpenAI API (for TTS voice generation)
# Get this from https://platform.openai.com/api-keys
# Used by scripts/generate-tts.ts to generate high-quality voice audio
# @see ADR-015 (OpenAI TTS for Realistic Voice Output)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-api-key

# -----------------------------------------------------------------------------
# Cloudflare R2 Storage (for audio file uploads)
# Get these from Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
# Required for production TTS audio uploads
# -----------------------------------------------------------------------------
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=playlexi-assets

# -----------------------------------------------------------------------------
# Admin API Secret (for cron jobs and admin endpoints)
# Used by /api/admin/cleanup and /api/admin/generate-puzzles
# Generate with: openssl rand -base64 32
# Set in Cloudflare via: wrangler secret put ADMIN_CLEANUP_SECRET
# -----------------------------------------------------------------------------
ADMIN_CLEANUP_SECRET=your-admin-secret
